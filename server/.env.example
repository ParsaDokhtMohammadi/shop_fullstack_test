# Copy to .env and fill in. .env is gitignored — never commit real values.

NODE_ENV=development
PORT=3000

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=shop

# Local development only. Must stay false in production: migrations own the
# schema there, and letting TypeORM alter a live one on boot loses client data.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Managed Postgres (Liara, Arvan, DigitalOcean, Neon) refuses plaintext
# connections — set this to true there, or the app cannot connect at all.
# Leave false for a local postgres.
DB_SSL=false
# Only read when DB_SSL=true. Those providers often present a self-signed or
# private-CA certificate, and the connection then fails with
# SELF_SIGNED_CERT_IN_CHAIN. Setting this to false keeps the traffic encrypted
# but stops checking who is on the other end, so try the provider's CA
# certificate first and treat this as the fallback.
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Auth ---
# Required — the app refuses to start without it. Any long random string;
# at least 32 characters, and a short one is fatal in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# A timespan jsonwebtoken understands: 60, "120s", "7d", "10h". Checked at boot,
# because a typo here would otherwise only surface as a failed login.
JWT_EXPIRES_IN=7d

# --- Uploads ---
# Local disk storage, served publicly at UPLOAD_PUBLIC_PATH. Relative values
# resolve against the project root; an absolute path is used as-is.
#
# In a container this MUST point at a mounted volume, e.g. /data/uploads. The
# image's own filesystem is discarded on every redeploy, so the files would go
# while the product_image rows kept pointing at them — a shop of broken images
# with no way back, since the originals only ever existed in that container.
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_SIZE_MB=5

# --- CORS ---
# Comma-separated allow-list of frontend origins. No wildcards: browsers reject
# them when the request carries credentials, and auth here is a cookie.
CORS_ORIGINS=http://localhost:3000

# --- Proxies ---
# How many reverse proxies sit in front of this app. It decides what req.ip is,
# and the rate limiter counts per ip — so behind nginx, leaving this unset makes
# every per-ip limit a shop-wide one (two OTP requests from anyone would use up
# the allowance for everyone).
#
#   unset / false  exposed directly, no proxy (the default)
#   1              one reverse proxy, e.g. nginx
#   2              Cloudflare in front of nginx
#   true           trust every X-Forwarded-For entry — do not use in production
#
# Only count proxies you actually control. Anything beyond them comes from a
# header the client writes, so guessing high lets an attacker present a fresh
# ip per request and never be rate limited at all.
TRUST_PROXY=

# SMS
# mock = log the message to the console (development). kavenegar = really send it.
SMS_PROVIDER=mock
# Required when SMS_PROVIDER=kavenegar — the app refuses to start without them.
SMS_KAVENEGAR_API_KEY=
SMS_KAVENEGAR_SENDER=

# Payments
# mock = no gateway; the redirect url points back at our own callback with
# Status=OK, so a developer can click through a real checkout. zarinpal = live.
PAYMENT_PROVIDER=mock
# Must be a url this API serves. For Zarinpal its domain has to be the one
# registered with them — Shaparak checks it.
PAYMENT_CALLBACK_URL=http://localhost:3000/api/payments/callback
# A page in the storefront. The callback redirects the customer here with
# ?status=&message=&order=&ref=
PAYMENT_RESULT_URL=http://localhost:5173/payment/result
# Required when PAYMENT_PROVIDER=zarinpal — the app refuses to start without it.
ZARINPAL_MERCHANT_ID=

# Admins
# Comma-separated phone numbers that should own the admin panel. Any spelling
# works — 09123456789, +989123456789, 00989123456789 are all the same number.
#
# Only the PromoteAdmins migration reads this, so it takes effect on
# `pnpm migration:run`, not on boot. A number with no account yet gets one
# created as an admin, so it is an admin from its very first OTP login.
#
# Adding a number here later needs a new migration — a migration that has
# already run is recorded as done and will not run again.
ADMIN_PHONE_NUMBERS=
