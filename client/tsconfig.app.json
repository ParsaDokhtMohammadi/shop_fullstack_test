{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type safety. `strict` is the whole family at once — the important one
       here is strictNullChecks, because every nullable column the API returns
       (coverImage, color, fullName, trackingCode) then has to be handled
       instead of silently rendering "null". */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* `@/x` instead of `../../../x`. This teaches the type checker; the
       matching `resolve.alias` in vite.config.ts teaches the bundler. Both
       are required — changing one without the other breaks the build. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
