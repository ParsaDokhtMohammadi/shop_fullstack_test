# Copy to .env.local for development, or .env.production before a build.
# Everything here is public: it is compiled into the JavaScript the browser
# downloads, so never put a secret, token or password in a VITE_ variable.

# Where the API lives, as an origin with no trailing slash and no /api.
# The client appends /api itself, and resolves image paths like
# /uploads/x.webp against the same origin.
#
# Leave it EMPTY for a same-origin deployment — the normal case, where nginx
# serves this app and reverse-proxies /api to NestJS. Requests then go to
# /api/... on whatever host the page was loaded from, which is also what the
# dev server's proxy does.
#
# Set it only when the API is on a different origin, e.g.
#   VITE_API_BASE_URL=http://192.168.1.50:3000
# That is a cross-origin setup, so the backend's CORS_ORIGINS must list this
# app's origin and the API must be reachable from the browser, not just from
# the VM.
VITE_API_BASE_URL=

# Development only, ignored in a production build. Where `pnpm dev` proxies
# /api and /uploads to. Defaults to http://localhost:3000.
VITE_DEV_API_PROXY=http://localhost:3000
